<?xml version="1.0" encoding="utf-8"?>
<!-- Vidro fosco claro: branco leitoso, contorno luminoso e sombra suave por baixo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><gradient android:angle="300" android:startColor="#E6FAFCFF" android:centerColor="#CCEFF3F9" android:endColor="#D9E6ECF5" /><corners android:radius="26dp" /></shape></item>
    <item android:bottom="70dp"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
        <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#FFFFFFFF" /><corners android:radius="26dp" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#14203040" /><corners android:radius="25dp" /></shape></item>
</layer-list>
