<?xml version="1.0" encoding="utf-8"?>
<!-- Vidro fosco escuro: fumado, leitoso, com brilho no topo e contorno de luz -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#99232B3C" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="315" android:startColor="#38FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#24FFFFFF" /><corners android:radius="26dp" /></shape></item>
    <item android:bottom="70dp"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#29FFFFFF" android:endColor="#00FFFFFF" />
        <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#73FFFFFF" /><corners android:radius="26dp" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#1AFFFFFF" /><corners android:radius="25dp" /></shape></item>
</layer-list>
