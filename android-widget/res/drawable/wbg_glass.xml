<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: quase transparente, véu leve e frio, brilho suave no canto e contorno de luz fino -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#2EC8D6EC" android:centerColor="#1A9FB2D0" android:endColor="#248FA4C4" /><corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:type="radial" android:gradientRadius="260dp" android:centerX="0.12" android:centerY="0.0" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" /><corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:type="radial" android:gradientRadius="200dp" android:centerX="0.9" android:centerY="1.0" android:startColor="#14BFD8FF" android:endColor="#00FFFFFF" /><corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#47FFFFFF" /><corners android:radius="28dp" /></shape></item>
</layer-list>
