<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_round" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Cena" />
    <FrameLayout android:id="@+id/w_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wscrim" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="14dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextClock android:id="@+id/w_clock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:format24Hour="HH:mm" android:format12Hour="h:mm" android:textColor="#FFFFFFFF" android:textSize="54sp" android:fontFamily="sans-serif-thin" android:includeFontPadding="false" android:maxLines="1" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/w_icon" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="fitCenter" android:contentDescription="Tempo" android:layout_marginEnd="6dp" />
                    <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="30sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-light" />
                </LinearLayout>
                <TextView android:id="@+id/w_cond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextClock android:id="@+id/w_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:format24Hour="EEEE, d MMM" android:format12Hour="EEEE, d MMM" android:textColor="#E6FFFFFF" android:textSize="14sp" android:maxLines="1" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" />
            <ImageView android:id="@+id/w_refresh" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wi_refresh" android:alpha="0.75" android:contentDescription="Atualizar" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/w_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" />
            <TextView android:id="@+id/w_hilo" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginStart="8dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
