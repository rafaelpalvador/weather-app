<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_round" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Cena" />
    <FrameLayout android:id="@+id/w_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wscrim" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_city" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:layout_weight="1" />
            <ImageView android:id="@+id/w_refresh" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wi_refresh" android:alpha="0.75" android:contentDescription="Atualizar" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="42sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-light" android:layout_weight="1" />
            <ImageView android:id="@+id/w_icon" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:contentDescription="Tempo"  />
        </LinearLayout>
        <TextView android:id="@+id/w_cond" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/w_hilo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="3dp" />
    </LinearLayout>
</FrameLayout>
