{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "Céu",
 "mainBinaryName": "Ceu",
 "version": "0.1.0",
 "identifier": "app.ceu.tempo",
 "build": {
  "frontendDist": "../src"
 },
 "app": {
  "withGlobalTauri": true,
  "windows": [
   {
    "title": "Céu — Previsão do tempo",
    "width": 460,
    "height": 900,
    "minWidth": 360,
    "minHeight": 560
   }
  ],
  "security": {
   "csp": null
  }
 },
 "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png",
   "icons/icon.png",
   "icons/icon.icns",
   "icons/icon.ico"
  ],
  "category": "Weather",
  "shortDescription": "Previsão do tempo pessoal"
 }
}
